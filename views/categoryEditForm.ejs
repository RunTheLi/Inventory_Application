<!--views/categoryEditForm.ejs-->
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Edit Category - Inventory App</title>

  <link rel="stylesheet" href="/styles.css">
</head>

<body>

  <header class="header">
    <div class="container">

      <a href="/" class="back-link">
        ← Back to Inventory
      </a>

      <h1>Edit Category</h1>

      <p>Update your category name.</p>

    </div>
  </header>

  <main class="container">

    <section class="form-card">

      <form method="POST" action="/categories/<%= category.id %>/edit">

        <div class="form-group">

          <label for="name">
            Category Name
          </label>

          <input
            type="text"
            id="name"
            name="name"
            value="<%= category.name %>"
            required
          >

        </div>

        <div class="form-actions">

          <a
            href="/categories/<%= category.id %>"
            class="button secondary-button"
          >
            Cancel
          </a>

          <button type="submit" class="button">
            Update Category
          </button>

        </div>

      </form>

    </section>

  </main>

</body>

</html>