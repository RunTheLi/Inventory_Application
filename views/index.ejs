<!-- views/index.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inventory App</title>

  <link rel="stylesheet" href="/styles.css">
</head>

<body>

  <header class="header">
    <div class="container">
      <h1>📦 Inventory App</h1>
      <p>Manage your inventory easily.</p>
    </div>
  </header>


  <main class="container">

    <!-- Categories -->

    <section class="section">

      <div class="section-header">
        <h2>Categories</h2>

        <a href="/categories/new" class="button">
          + New Category
        </a>
      </div>

      <div class="category-list">

        <% categories.forEach(category => { %>

          <a
            href="/categories/<%= category.id %>"
            class="category-card"
          >
            <h3><%= category.name %></h3>
          </a>

        <% }); %>

      </div>

    </section>


    <!-- Items -->

    <section class="section">

      <div class="section-header">
        <h2>Items</h2>

        <a href="/items/new" class="button">
          + New Item
        </a>
      </div>

      <div class="items-list">

        <% items.forEach(item => { %>

          <a
            href="/items/<%= item.id %>"
            class="item-card"
          >

            <div>
              <h3><%= item.item_name %></h3>

              <p class="category">
                <%= item.category_name %>
              </p>
            </div>

            <div class="item-info">

              <span>
                Quantity: <strong><%= item.quantity %></strong>
              </span>

              <span>
                Price: <strong>฿<%= item.price %></strong>
              </span>

            </div>

          </a>

        <% }); %>

      </div>

    </section>

  </main>

</body>
</html>