<!-- views/index.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Inventory App</title>
</head>
<body>

  <h1>Inventory App</h1>

  <h2>Categories</h2>

  <a href="/categories/new">Create New Category</a>

  <ul>
    <% categories.forEach(category => { %>
      <li>
        <a href="/categories/<%= category.id %>">
          <%= category.name %>
        </a>
      </li>
    <% }); %>
  </ul>


  <h2>Items</h2>

  <a href="/items/new">Create New Item</a>

  <ul>
    <% items.forEach(item => { %>
      <li>
        <strong>
          <a href="/items/<%= item.id %>">
            <%= item.item_name %>
          </a>
        </strong>
        <br>

        Category: <%= item.category_name %><br>
        Quantity: <%= item.quantity %><br>
        Price: <%= item.price %><br>
        <%= item.description %>
      </li>
    <% }); %>
  </ul>

</body>
</html>