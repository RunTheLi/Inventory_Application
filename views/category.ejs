<!-- views/category.ejs -->

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Inventory App</title>
</head>
<body>
  <h1><%= category.name %></h1>

  <h2>Items</h2> 
  
  <ul> 
    <% items.forEach(item => { %> 
      <li> 
        <strong><%= item.item_name %></strong><br> 
        Category: <%= item.category_name %><br> 
        Quantity: <%= item.quantity %><br> 
        Price: <%= item.price %><br> 
        <%= item.description %> 
    </li> <% }); %> 
  </ul>

</body>
</html>