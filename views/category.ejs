<!-- views/category.ejs -->

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= category.name %> - Inventory App</title>

  <link rel="stylesheet" href="/styles.css">
</head>

<body>

  <header class="header">
    <div class="container">

      <a href="/" class="back-link">
        ← Back to Inventory
      </a>

      <h1><%= category.name %></h1>
      <p>Items in this category</p>

    </div>
  </header>


  <main class="container">

    <section class="section">

      <div class="section-header">

        <h2>Items</h2>

        <div>
          <a
            href="/categories/<%= category.id %>/edit"
            class="button"
          >
            Edit Category
          </a>

          <form
            method="POST"
            action="/categories/<%= category.id %>/delete"
            style="display: inline;"
          >
            <button type="submit" class="button delete-button">
              Delete Category
            </button>
          </form>
        </div>

      </div>


      <div class="items-list">

        <% if (items.length === 0) { %>

          <div class="empty-state">
            <p>No items in this category yet.</p>

            <a href="/items/new" class="button">
              + Add Item
            </a>
          </div>

        <% } %>


        <% items.forEach(item => { %>

          <a
            href="/items/<%= item.id %>"
            class="item-card"
          >

            <div>

              <h3>
                <%= item.name %>
              </h3>

              <p class="category">
                <%= category.name %>
              </p>

            </div>

            <div class="item-info">

              <span>
                Quantity:
                <strong><%= item.quantity %></strong>
              </span>

              <span>
                Price:
                <strong>฿<%= item.price %></strong>
              </span>

            </div>

          </a>

        <% }); %>

      </div>

    </section>

  </main>

</body>
</html>