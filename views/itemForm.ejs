<!--views/itemForm-->

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>New Item - Inventory App</title>

  <link rel="stylesheet" href="/styles.css">
</head>

<body>

  <header class="header">
    <div class="container">

      <a href="/" class="back-link">
        ← Back to Inventory
      </a>

      <h1>New Item</h1>

      <p>Add a new item to your inventory.</p>

    </div>
  </header>

  <main class="container">

    <section class="form-card">

      <form method="POST" action="/items/new">

        <div class="form-group">

          <label for="name">
            Item Name
          </label>

          <input
            type="text"
            id="name"
            name="name"
            placeholder="e.g. Apple"
            required
          >

        </div>

        <br>

        <div class="form-group">

          <label for="quantity">
            Quantity
          </label>

          <input
            type="number"
            id="quantity"
            name="quantity"
            min="0"
            required
          >

        </div>

        <br>

        <div class="form-group">

          <label for="price">
            Price
          </label>

          <input
            type="number"
            id="price"
            name="price"
            min="0"
            step="0.01"
            placeholder="0.00"
            required
          >

        </div>

        <br>

        <div class="form-group">

          <label for="description">
            Description
          </label>

          <textarea
            id="description"
            name="description"
            rows="5"
            placeholder="Describe the item..."
          ></textarea>

        </div>

        <br>

        <div class="form-group">

          <label for="categoryId">
            Category
          </label>

          <select
            id="categoryId"
            name="categoryId"
            required
          >

            <option value="" disabled selected>
              -- Select a Category --
            </option>

            <% categories.forEach(category => { %>

              <option value="<%= category.id %>">
                <%= category.name %>
              </option>

            <% }); %>

          </select>

        </div>

        <div class="form-actions">

          <a href="/" class="button secondary-button">
            Cancel
          </a>

          <button type="submit" class="button">
            Create Item
          </button>

        </div>

      </form>

    </section>

  </main>

</body>

</html>