<!-- views/item.ejs -->

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= item.name %></title>
</head>
<body>
  <h1><%= item.name %></h1>

  <p>Category ID: <%= item.category_id %></p>
